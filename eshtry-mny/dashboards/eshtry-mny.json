{
  "title": "Eshtry-Mny",
  "uid": "eshtry-mny",
  "tags": ["eshtry-mny", "mern", "k3s", "devsecops"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 0, "type": "text", "title": "", "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "html",
        "content": "<div style=\"font-family:Inter,system-ui,sans-serif;padding:6px 4px\"><div style=\"font-size:22px;font-weight:700;letter-spacing:.3px\">🛍️  Eshtry-Mny &nbsp;<span style=\"font-size:12px;font-weight:500;opacity:.6\">MERN microservices on k3s</span></div><div style=\"margin-top:6px;font-size:12px;opacity:.8\">Jenkins → Harbor (signed by digest) → Argo CD · Kyverno admission · namespace <b>eshtry-mny</b></div></div>"
      }
    },

    { "id": 1, "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 }, "collapsed": false },

    { "id": 2, "type": "stat", "title": "Services up", "gridPos": { "h": 5, "w": 4, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(up{namespace=\"eshtry-mny\"})", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 3 } ] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "auto" } },

    { "id": 3, "type": "stat", "title": "Requests / sec", "gridPos": { "h": 5, "w": 4, "x": 4, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(rate(http_requests_total{namespace=\"eshtry-mny\"}[5m]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "auto" } },

    { "id": 4, "type": "gauge", "title": "5xx error rate", "gridPos": { "h": 5, "w": 4, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "100 * sum(rate(http_requests_total{namespace=\"eshtry-mny\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"eshtry-mny\"}[5m])), 0.001)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 10, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "showThresholdLabels": false, "showThresholdMarkers": true } },

    { "id": 5, "type": "stat", "title": "p95 latency", "gridPos": { "h": 5, "w": 4, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"eshtry-mny\"}[5m])) by (le))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 } ] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "auto" } },

    { "id": 6, "type": "stat", "title": "Pods running", "gridPos": { "h": 5, "w": 4, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "count(kube_pod_status_phase{namespace=\"eshtry-mny\",phase=\"Running\"} == 1)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 4 }, { "color": "green", "value": 5 } ] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "auto" } },

    { "id": 7, "type": "stat", "title": "Restarts (1h)", "gridPos": { "h": 5, "w": 4, "x": 20, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"eshtry-mny\"}[1h]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "auto" } },

    { "id": 10, "type": "row", "title": "Golden Signals", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false },

    { "id": 11, "type": "timeseries", "title": "Request rate (req/s)", "gridPos": { "h": 9, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (job) (rate(http_requests_total{namespace=\"eshtry-mny\"}[5m]))", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 18, "gradientMode": "opacity", "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 12, "type": "timeseries", "title": "Error rate (5xx/s)", "gridPos": { "h": 9, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (job) (rate(http_requests_total{namespace=\"eshtry-mny\",status=~\"5..\"}[5m]))", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 18, "gradientMode": "opacity", "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 13, "type": "timeseries", "title": "Latency p50 / p90 / p95 / p99 (s)", "gridPos": { "h": 9, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=\"eshtry-mny\"}[5m])) by (le))", "refId": "p50", "legendFormat": "__auto" },
        { "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{namespace=\"eshtry-mny\"}[5m])) by (le))", "refId": "p90", "legendFormat": "__auto" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"eshtry-mny\"}[5m])) by (le))", "refId": "p95", "legendFormat": "__auto" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"eshtry-mny\"}[5m])) by (le))", "refId": "p99", "legendFormat": "__auto" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 14, "type": "timeseries", "title": "Top routes (req/s)", "gridPos": { "h": 8, "w": 16, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "topk(8, sum by (route) (rate(http_requests_total{namespace=\"eshtry-mny\"}[5m])))", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 12, "gradientMode": "opacity", "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 15, "type": "piechart", "title": "Response status distribution", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (status) (increase(http_requests_total{namespace=\"eshtry-mny\"}[1h]))", "refId": "A", "legendFormat": "__auto" } ],
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": [ "value", "percent" ] }, "reduceOptions": { "calcs": [ "lastNotNull" ] } } },

    { "id": 20, "type": "row", "title": "Kubernetes", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false },

    { "id": 21, "type": "timeseries", "title": "Deployment replicas (ready vs desired)", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "kube_deployment_status_replicas_ready{namespace=\"eshtry-mny\"}", "refId": "ready", "legendFormat": "__auto" },
        { "expr": "kube_deployment_spec_replicas{namespace=\"eshtry-mny\"}", "refId": "desired", "legendFormat": "__auto" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 0, "lineWidth": 2, "lineInterpolation": "stepAfter", "showPoints": "auto", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 22, "type": "timeseries", "title": "HPA replicas (current vs max)", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"eshtry-mny\"}", "refId": "current", "legendFormat": "__auto" },
        { "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"eshtry-mny\"}", "refId": "max", "legendFormat": "__auto" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 0, "lineWidth": 2, "lineInterpolation": "stepAfter", "showPoints": "auto", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 23, "type": "timeseries", "title": "Pod restarts by pod (increase 1h)", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"eshtry-mny\"}[1h]))", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "gradientMode": "opacity", "lineWidth": 1, "lineInterpolation": "stepAfter", "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 24, "type": "piechart", "title": "Pods by phase", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"eshtry-mny\"} == 1)", "refId": "A", "legendFormat": "__auto" } ],
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": [ "value", "percent" ] }, "reduceOptions": { "calcs": [ "lastNotNull" ] } } },

    { "id": 25, "type": "timeseries", "title": "CPU usage by pod (cores)", "gridPos": { "h": 8, "w": 16, "x": 8, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"eshtry-mny\",container!=\"\"}[5m]))", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "cores", "custom": { "fillOpacity": 18, "gradientMode": "opacity", "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 30, "type": "row", "title": "Resources", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }, "collapsed": false },

    { "id": 31, "type": "timeseries", "title": "Memory working set by pod", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"eshtry-mny\",container!=\"\"})", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 18, "gradientMode": "opacity", "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 32, "type": "timeseries", "title": "Network by pod (RX / TX)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"eshtry-mny\"}[5m]))", "refId": "rx", "legendFormat": "__auto" },
        { "expr": "-sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"eshtry-mny\"}[5m]))", "refId": "tx", "legendFormat": "__auto" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 18, "gradientMode": "opacity", "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi" } } },

    { "id": 40, "type": "row", "title": "Nodes & Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 }, "collapsed": false },

    { "id": 41, "type": "gauge", "title": "Node CPU utilisation", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "showThresholdMarkers": true } },

    { "id": 42, "type": "gauge", "title": "Node memory used", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "showThresholdMarkers": true } },

    { "id": 43, "type": "gauge", "title": "Node disk used (/)", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})", "refId": "A", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "showThresholdMarkers": true } },

    { "id": 44, "type": "stat", "title": "Prometheus targets up", "gridPos": { "h": 6, "w": 8, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(up{namespace=\"eshtry-mny\"})", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 3 } ] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "value_and_name" } },

    { "id": 45, "type": "stat", "title": "MongoDB pod", "gridPos": { "h": 6, "w": 8, "x": 8, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "count(kube_pod_status_phase{namespace=\"eshtry-mny\",pod=~\"mongodb-.*\",phase=\"Running\"} == 1)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "value_and_name" } },

    { "id": 46, "type": "stat", "title": "MongoDB memory", "gridPos": { "h": 6, "w": 8, "x": 16, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(container_memory_working_set_bytes{namespace=\"eshtry-mny\",pod=~\"mongodb-.*\",container!=\"\"})", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": [ "lastNotNull" ] }, "textMode": "value_and_name" } }
  ]
}
